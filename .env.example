# SocialOS — configuration for `docker compose up`. Copy to .env (`make env` does it and
# generates ENCRYPTION_KEY). Never commit .env. Values below are local placeholders, not secrets.
# Component-level references with every option: backend/.env.example, frontend/.env.example, mcp/README.md.

APP_ENV=development

# PostgreSQL (compose builds DATABASE_URL from these; set DATABASE_URL directly when running on the host)
POSTGRES_USER=socialos
POSTGRES_PASSWORD=socialos
POSTGRES_DB=socialos
DATABASE_URL=postgres://socialos:socialos@localhost:5432/socialos?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# AES-256-GCM key for OAuth tokens at rest: openssl rand -base64 32. Changing it makes stored tokens unreadable.
ENCRYPTION_KEY=
# Optional bearer token for /metrics
METRICS_TOKEN=
# Browser sessions are opaque server-side sessions (revocable), so no JWT_SECRET is needed.
COOKIE_SECURE=false

# Public URLs
API_PUBLIC_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3333/mcp
MCP_BASE_URL=http://localhost:3333

# S3-compatible storage (MinIO locally; Cloudflare R2 / AWS S3 in production)
S3_ENDPOINT=localhost:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=socialos
S3_SECRET_KEY=socialos-dev-secret
S3_BUCKET=socialos-media
S3_REGION=us-east-1

# Social providers
# Mock network for development without real credentials. Never enable in production.
SOCIAL_MOCK_PROVIDERS=true
# LinkedIn app: products "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn";
# redirect URL: ${API_PUBLIC_URL}/api/v1/social/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Telegram bot from @BotFather; users add it as an admin of their channel.
TELEGRAM_BOT_TOKEN=
