# SocialOS sites for a host Caddy that already owns ports 80/443.
# Generated by host-proxy/render-caddy.sh from .env: do not edit by hand, edit .env and render again.
# It is pulled into the host Caddyfile by one line: import /opt/socialos/caddy/*.caddy
# It sets no global options on purpose (email, ACME CA, ... belong to the host's Caddyfile). It mirrors deploy/Caddyfile,
# the standalone configuration; keep the two in step.

# Snippet names are global in a Caddyfile, hence the prefix.
(socialos_common) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Web UI. /api/v1/* is proxied to the backend by the Next.js server itself, so browsers only ever talk to this origin.
app.@DOMAIN@ {
	import socialos_common
	encode zstd gzip
	header {
		X-Frame-Options "DENY"
		# Media previews use presigned URLs minted for the bundled MinIO; they are http:// URLs on s3.<domain>.
		# This makes the browser fetch them over https (the signature does not cover the scheme).
		Content-Security-Policy "upgrade-insecure-requests"
	}
	reverse_proxy 127.0.0.1:@FRONTEND_PORT@
}

# REST API for API-key clients, OAuth callbacks (LinkedIn) and the Telegram webhook.
api.@DOMAIN@ {
	import socialos_common
	encode zstd gzip
	# Prometheus metrics are for the internal network only.
	@metrics path /metrics /metrics/*
	respond @metrics 404
	reverse_proxy 127.0.0.1:@BACKEND_PORT@
}

# MCP server (stateless Streamable HTTP, POST /mcp, Authorization: Bearer sk_live_...). Compression is skipped on purpose.
mcp.@DOMAIN@ {
	import socialos_common
	reverse_proxy 127.0.0.1:@MCP_PORT@ {
		flush_interval -1
	}
}

# @@S3_BEGIN@@
# Presigned media URLs of the bundled MinIO. Host and path are part of the S3 signature, so the request is
# forwarded untouched. Left out when S3_SITE starts with ":" (external S3/R2) or the minio profile is off.
@S3_SITE@ {
	import socialos_common
	reverse_proxy 127.0.0.1:@MINIO_PORT@ {
		flush_interval -1
	}
}
# @@S3_END@@
