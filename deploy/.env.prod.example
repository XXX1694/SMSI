# SocialOS production configuration for deploy/docker-compose.prod.yml.
#
#   cp .env.prod.example .env      (or, better: ./init-env.sh example.com you@example.com  -> also generates every secret)
#
# Values that start with CHANGE_ME must be replaced; deploy.sh refuses to run while any are left.
# Never commit the real .env. Keep a copy of it somewhere safe: losing ENCRYPTION_KEY makes every stored
# social-account token unreadable (users would have to reconnect their accounts).
# Plain values only: no quotes, no spaces, no trailing comments on a value line.

# ---- Domain & HTTPS ---------------------------------------------------------------------------------------------
# Apex domain you control. Caddy serves app.$DOMAIN (web UI), api.$DOMAIN (REST API, OAuth callbacks, Telegram
# webhook), mcp.$DOMAIN (MCP server) and, with the bundled MinIO, s3.$DOMAIN (presigned media URLs).
# Create an A (and AAAA) record for each of those names pointing at this server before the first deploy.
DOMAIN=CHANGE_ME_example.com
# Contact address for Let's Encrypt (expiry warnings). Required.
ACME_EMAIL=CHANGE_ME_you@example.com
# Optional. Domain of the session cookie. Defaults to $DOMAIN so the login (issued via app.$DOMAIN) is also sent to
# api.$DOMAIN, where the LinkedIn OAuth callback arrives. Leave it unset unless you know you need something else.
#COOKIE_DOMAIN=

# ---- Images -----------------------------------------------------------------------------------------------------
# GitHub owner of the GHCR images ghcr.io/<owner>/socialos-{backend,mcp,frontend}. Lowercase.
GHCR_OWNER=xxx1694
# Written by deploy.sh on every successful deploy. Set it by hand only for the very first `docker compose up`.
# sha-<7 hex> tags are immutable and what you want in production; "main" moves with every merge.
IMAGE_TAG=main

# ---- Compose settings -------------------------------------------------------------------------------------------
# Lets you type plain `docker compose ps|logs|exec ...` in this directory.
COMPOSE_FILE=docker-compose.prod.yml
# minio = run the bundled MinIO (default). Remove the value (COMPOSE_PROFILES=) when you use external S3/R2 below.
COMPOSE_PROFILES=minio

# ---- Secrets (generated by ./init-env.sh; commands shown for doing it by hand) ----------------------------------
# openssl rand -hex 24   (hex only: it is embedded in a connection URL)
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
# openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24
# base64 of 32 random bytes: openssl rand -base64 32. AES-256-GCM key for OAuth tokens at rest. Never change it.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
# openssl rand -hex 24. Bearer token for GET /metrics (that path is not routed publicly by Caddy anyway).
METRICS_TOKEN=CHANGE_ME_openssl_rand_hex_24

# ---- PostgreSQL -------------------------------------------------------------------------------------------------
# Only read when the database volume is created. Changing them later does not rename the role/database.
POSTGRES_USER=socialos
POSTGRES_DB=socialos

# ---- Object storage (media uploads) -----------------------------------------------------------------------------
# Bundled MinIO (COMPOSE_PROFILES=minio): the root user/password of MinIO and the S3 credentials the backend uses.
# openssl rand -hex 8   /   openssl rand -hex 24   (MinIO wants an access key of 3+ and a secret of 8+ characters)
S3_ACCESS_KEY=CHANGE_ME_openssl_rand_hex_8
S3_SECRET_KEY=CHANGE_ME_openssl_rand_hex_24
S3_BUCKET=socialos-media
S3_REGION=us-east-1
# With the bundled MinIO leave these four unset: the backend talks to minio:9000 inside the compose network and
# presigned URLs use s3.$DOMAIN (served by Caddy; the web app upgrades them to https via CSP).
#
# External S3 / Cloudflare R2 instead: remove the minio profile above, uncomment and fill in, then restart:
#S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
#S3_USE_SSL=true
#S3_PUBLIC_ENDPOINT=
#S3_SITE=:8099
#S3_AUTO_CREATE_BUCKET=false
# (S3_ENDPOINT is host[:port] without a scheme. Setting S3_PUBLIC_ENDPOINT to an empty value makes presigned
#  URLs use S3_ENDPOINT. S3_SITE=:8099 disables the s3.$DOMAIN site in Caddy.)

# ---- Social networks ----------------------------------------------------------------------------------------------
# LinkedIn app (https://www.linkedin.com/developers/apps): products "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn"; authorized redirect URL: https://api.$DOMAIN/api/v1/social/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Telegram bot from @BotFather (one bot per deployment). Empty = Telegram disabled.
TELEGRAM_BOT_TOKEN=
# Production always runs TELEGRAM_UPDATES_MODE=webhook. Telegram echoes this secret in the
# X-Telegram-Bot-Api-Secret-Token header; 16+ chars of A-Za-z0-9_-:  openssl rand -hex 24
# After the first deploy register the webhook: docker compose -f docker-compose.prod.yml run --rm telegram set-webhook
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_24

# ---- Misc ---------------------------------------------------------------------------------------------------------
LOG_LEVEL=info
# Override the MinIO image (the default is pinned in docker-compose.prod.yml).
#MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
