# Looks for a new Steerpost release every 5 minutes. Turn updates off without removing the timer: AUTOUPDATE=false in
# /opt/socialos/.env. Install: README, section 14.
[Unit]
Description=Steerpost: look for a new release every 5 minutes

[Timer]
OnCalendar=*:0/5
# Spread the load on the GitHub API and on this host, and do not start at the same second as everything else.
RandomizedDelaySec=60
# Run once after boot or downtime if a tick was missed.
Persistent=true
Unit=socialos-autoupdate.service

[Install]
WantedBy=timers.target
