# Where the Next.js server proxies /api/v1/* to (server-side only).
API_INTERNAL_URL=http://localhost:8080
# Public URLs shown in the ready-to-paste MCP client config (browser-visible).
NEXT_PUBLIC_MCP_URL=http://localhost:3333/mcp
NEXT_PUBLIC_API_URL=http://localhost:8080
# For UI work without the backend: `npm run mock-api` serves the contract on :8080 (see scripts/mock-api.mjs).
