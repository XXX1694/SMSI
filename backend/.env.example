# SocialOS backend configuration. Copy to .env (`make env` does this and generates
# ENCRYPTION_KEY for you). Never commit .env. Values below are local-development
# placeholders, not secrets.

# ---- core ---------------------------------------------------------------
# development | production. Production refuses COOKIE_SECURE=false, STORAGE_DRIVER=memory
# and SOCIAL_MOCK_PROVIDERS=true at startup.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# json | text
LOG_FORMAT=text

# ---- PostgreSQL / Redis ---------------------------------------------------
DATABASE_URL=postgres://socialos:socialos@127.0.0.1:5432/socialos?sslmode=disable
DB_MAX_CONNS=20
REDIS_URL=redis://127.0.0.1:6379/0
# Asynq queue name; the API and the worker must agree on it.
QUEUE_NAME=publish
# Run goose migrations when the API starts (otherwise run `make migrate` / the migrate binary).
MIGRATE_ON_START=false

# ---- secrets ---------------------------------------------------------------
# base64 of 32 random bytes: openssl rand -base64 32
# Encrypts OAuth tokens at rest. Losing or changing it makes stored tokens unreadable.
ENCRYPTION_KEY=
# Optional bearer token protecting /metrics (leave empty to expose it to the network that can reach the API).
METRICS_TOKEN=

# ---- public URLs ------------------------------------------------------------
# Base of this API as seen by browsers/providers (OAuth redirect URIs are built from it).
API_PUBLIC_URL=http://localhost:8080
# Frontend origin (post-connect redirects).
WEB_BASE_URL=http://localhost:3000
# Comma separated, explicit origins only ("*" is rejected: cookies are credentialed).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# URL of the socialos-mcp server, used in the generated MCP client configuration.
MCP_PUBLIC_URL=http://localhost:3333/mcp

# ---- sessions & limits -------------------------------------------------------
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_TTL=168h
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_RPS=0.2
AUTH_RATE_LIMIT_BURST=10
# Honour X-Forwarded-For (only behind a reverse proxy you control).
TRUST_PROXY=false

# ---- worker --------------------------------------------------------------------
WORKER_CONCURRENCY=10
RECONCILE_INTERVAL=1m
# Health/metrics listener of the worker process.
WORKER_HTTP_ADDR=:8081

# ---- object storage -------------------------------------------------------------
# s3 (MinIO/AWS S3/R2...) or memory (development only; lost on restart).
STORAGE_DRIVER=s3
S3_ENDPOINT=localhost:9000
# Optional host used in presigned URLs when browsers reach storage under another name.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=socialos-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_AUTO_CREATE_BUCKET=true

# ---- social providers ------------------------------------------------------------
# Deterministic fake network for local development and tests. Never enable in production.
SOCIAL_MOCK_PROVIDERS=true
# LinkedIn: create an app, enable "Share on LinkedIn", add API_PUBLIC_URL/api/v1/social/linkedin/callback as redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606
LINKEDIN_USE_PKCE=true
# Telegram: one bot per deployment (@BotFather). Users add the bot as admin of their channel/group.
TELEGRAM_BOT_TOKEN=
